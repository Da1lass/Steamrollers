#region VEXcode Generated Robot Configuration
from vex import *
import urandom
import math

# Brain should be defined by default
brain=Brain()

# Robot configuration code
LeftFront = Motor(Ports.PORT11, GearSetting.RATIO_6_1, True)
LeftBack_motor_a = Motor(Ports.PORT12, GearSetting.RATIO_6_1, False)
LeftBack_motor_b = Motor(Ports.PORT13, GearSetting.RATIO_6_1, False)
LeftBack = MotorGroup(LeftBack_motor_a, LeftBack_motor_b)
RightFront = Motor(Ports.PORT14, GearSetting.RATIO_6_1, False)
RightBack_motor_a = Motor(Ports.PORT15, GearSetting.RATIO_6_1, True)
RightBack_motor_b = Motor(Ports.PORT16, GearSetting.RATIO_6_1, True)
RightBack = MotorGroup(RightBack_motor_a, RightBack_motor_b)
Intake = Motor(Ports.PORT20, GearSetting.RATIO_18_1, True)
MediumIntake = Motor(Ports.PORT10, GearSetting.RATIO_18_1, False)
StorageIntake = Motor(Ports.PORT9, GearSetting.RATIO_18_1, False)
TongueMech = DigitalOut(brain.three_wire_port.a)
Alighner = DigitalOut(brain.three_wire_port.b)
Flap = DigitalOut(brain.three_wire_port.c)
HoodDescore = DigitalOut(brain.three_wire_port.d)
controller_1 = Controller(PRIMARY)


# wait for rotation sensor to fully initialize
wait(30, MSEC)


# Make random actually random
def initializeRandomSeed():
    wait(100, MSEC)
    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()
    urandom.seed(int(random))
      
# Set random seed 
initializeRandomSeed()


def play_vexcode_sound(sound_name):
    # Helper to make playing sounds from the V5 in VEXcode easier and
    # keeps the code cleaner by making it clear what is happening.
    print("VEXPlaySound:" + sound_name)
    wait(5, MSEC)

# add a small delay to make sure we don't print in the middle of the REPL header
wait(200, MSEC)
# clear the console to make sure we don't have the REPL in the console
print("\033[2J")

#endregion VEXcode Generated Robot Configuration

myVariable = 0

def when_started1():
    global myVariable
    LeftFront.set_max_torque(100, PERCENT)
    LeftBack.set_max_torque(100, PERCENT)
    RightFront.set_max_torque(100, PERCENT)
    RightBack.set_max_torque(100, PERCENT)
    while True:
        LeftFront.set_velocity(((controller_1.axis3.position() + controller_1.axis1.position()) / -1), PERCENT)
        LeftBack.set_velocity(((controller_1.axis3.position() + controller_1.axis1.position()) / -1), PERCENT)
        RightFront.set_velocity(((controller_1.axis3.position() - controller_1.axis1.position()) / -1), PERCENT)
        RightBack.set_velocity(((controller_1.axis3.position() - controller_1.axis1.position()) / -1), PERCENT)
        LeftFront.spin(FORWARD)
        LeftBack.spin(FORWARD)
        RightFront.spin(FORWARD)
        RightBack.spin(FORWARD)
        wait(5, MSEC)

def when_started2():
    global myVariable
    Intake.set_velocity(100, PERCENT)
    Intake.set_max_torque(100, PERCENT)
    MediumIntake.set_velocity(100, PERCENT)
    MediumIntake.set_max_torque(100, PERCENT)
    StorageIntake.set_velocity(100, PERCENT)
    StorageIntake.set_max_torque(100, PERCENT)

def when_started3():
    global myVariable
    while True:
        if controller_1.buttonR1.pressing():
#scores to the top
            Intake.set_velocity(100, PERCENT)
            Intake.spin(FORWARD)
            MediumIntake.spin(REVERSE)
            StorageIntake.spin(REVERSE)
            Flap.set(True)
            Alighner.set(True)

        if controller_1.buttonR2.pressing():
#scores to the middle
            Intake.spin(FORWARD)
            MediumIntake.spin(FORWARD)
            StorageIntake.spin(REVERSE)
            TongueMech.set(True)
            Alighner.set(False)

        if controller_1.buttonL1.pressing():
#goes into the bucket
            Intake.spin(FORWARD)
            MediumIntake.spin(REVERSE)
            Flap.set(False)
            Alighner.set(False)
            TongueMech.set(True)

        if controller_1.buttonL2.pressing():
#scores through the bottom
            Intake.spin(REVERSE)
            MediumIntake.spin(REVERSE)
            StorageIntake.spin(REVERSE)
        
        if controller_1.buttonLeft.pressing():
            TongueMech.set(False)
        if controller_1.buttonUp.pressing():
            TongueMech.set(True)
        if controller_1.buttonX.pressing():
            Alighner.set(True)

        if controller_1.buttonB.pressing():
            StorageIntake.spin(FORWARD)
        else:
            StorageIntake.stop()

        if not (controller_1.buttonL1.pressing() or controller_1.buttonL2.pressing() or controller_1.buttonR1.pressing() or controller_1.buttonR2.pressing()):
            Intake.stop()
            MediumIntake.stop()
            

        if not (controller_1.buttonR1.pressing() or controller_1.buttonL2.pressing()):
            Intake.set_velocity(100, PERCENT)

ws2 = Thread( when_started2 )
ws3 = Thread( when_started3 )
when_started1()
