def ondriver_drivercontrol_2():
    global myVariable
    while True:
        if controller_1.buttonR1.pressing():
#scores to the top
            Intake.set_velocity(100, PERCENT)
            Intake.spin(FORWARD)
            MediumIntake.spin(REVERSE)
            StorageIntake.spin(REVERSE)
            Flap.set(True)
            Alighner.set(True)
            HoodDescore.set(True)
            TongueMech.set(False)

        if controller_1.buttonR2.pressing():
#scores to the middle
            Intake.spin(FORWARD)
            MediumIntake.spin(FORWARD)
            StorageIntake.spin(REVERSE)
            TongueMech.set(True)
            Alighner.set(False)

        if controller_1.buttonL1.pressing():
#goes into the bucket
            Intake.spin(FORWARD)
            MediumIntake.spin(REVERSE)
            Flap.set(False)
            Alighner.set(False)
            HoodDescore.set(False)

        if controller_1.buttonL2.pressing():
#scores through the bottom
            Intake.spin(REVERSE)
            MediumIntake.spin(REVERSE)
            StorageIntake.spin(REVERSE)
            TongueMech.set(False)
        
#all of the lower button code:
        if controller_1.buttonLeft.pressing():
            Alighner.set(True)
        if controller_1.buttonX.pressing():
            StorageIntake.spin(FORWARD)
        if controller_1.buttonY.pressing():
            DescoreHook.set(True)
        if controller_1.buttonRight.pressing():
            TongueMech.set(False)
        if controller_1.buttonDown.pressing():
            TongueMech.set(True)
        if controller_1.buttonB.pressing():
            DescoreHook.set(False)

        if not (controller_1.buttonL1.pressing() or controller_1.buttonL2.pressing() or controller_1.buttonR1.pressing() or controller_1.buttonR2.pressing() or controller_1.buttonB.pressing()):
            Intake.stop()
            MediumIntake.stop()
            StorageIntake.stop()

        if not (controller_1.buttonR1.pressing() or controller_1.buttonL2.pressing()):
            Intake.set_velocity(100, PERCENT)


# create a function for handling the starting and stopping of all autonomous tasks
def vexcode_auton_function():
    # Start the autonomous control tasks
    auton_task_0 = Thread( onauton_autonomous_0 )
    # wait for the driver control period to end
    while( competition.is_autonomous() and competition.is_enabled() ):
        # wait 10 milliseconds before checking again
        wait( 10, MSEC )
    # Stop the autonomous control tasks
    auton_task_0.stop()

def vexcode_driver_function():
    # Start the driver control tasks
    driver_control_task_0 = Thread( ondriver_drivercontrol_0 )
    driver_control_task_1 = Thread( ondriver_drivercontrol_1 )
    driver_control_task_2 = Thread( ondriver_drivercontrol_2 )

    # wait for the driver control period to end
    while( competition.is_driver_control() and competition.is_enabled() ):
        # wait 10 milliseconds before checking again
        wait( 10, MSEC )
    # Stop the driver control tasks
    driver_control_task_0.stop()


# register the competition functions
competition = Competition( vexcode_driver_function, vexcode_auton_function )
